<Application x:Class="xWPFUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:xWPFUI.Views"
             xmlns:viewmodels="clr-namespace:xWPFUI.ViewModels"
             xmlns:local="clr-namespace:xWPFUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DefinitionViewModel}">
                <views:DefineView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
