<UserControl x:Class="WpfUI.FurnaceElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfUI"
             mc:Ignorable="d" 
             Name="furnaceElement">
    <Grid>



        <StackPanel>

            <Button  Width="160" Margin="5 10" FocusVisualStyle="{x:Null}" Click="Button_Click"  >
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Height" Value="100"  />
                        <Setter Property="Foreground" Value="#E2E2E4" />
                        <Setter Property="BorderBrush" Value="Aqua" />
                        <Setter Property="BorderThickness" Value="6" />
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#464F78"/>
                                    <GradientStop Color="#323F6C" Offset="0.9"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderThickness="2" BorderBrush="Black" Background="{TemplateBinding Background}" CornerRadius="15,15,15,15">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="0">
                                <Setter Property="Background" Value="FloralWhite" />
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="1">
                                <Setter Property="Background" Value="Yellow" />
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="2">
                                <Setter Property="Background" Value="Coral" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="3">
                                <Setter Property="Background" Value="DarkGray" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="4">
                                <Setter Property="Background" Value="DarkGreen" />
                                <Setter Property="Foreground" Value="#ffffff" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <Grid Height="80" Width="160 ">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"  VerticalAlignment="Center" Orientation="Vertical">

                        <TextBlock Text="{Binding ElementName=furnaceElement,Path=Title }" FontSize="15" FontWeight="SemiBold" 
                       TextAlignment="Center" Margin="0 0 0 0" />

                    </StackPanel>

                    <StackPanel Grid.Row="1"  VerticalAlignment="Center" Orientation="Vertical">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="{Binding ElementName=furnaceElement,Path=Kg }" FontSize="12" FontWeight="SemiBold" 
                       TextAlignment="Center" Margin="0 0 1 0" />
                            <TextBlock Text="Kg" FontSize="12" FontWeight="SemiBold" ></TextBlock>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <TextBlock Text="{Binding ElementName=furnaceElement,Path=Adet }" FontSize="12" FontWeight="SemiBold"  TextAlignment="Right" Margin="0 0 0 0" />
                           
                            <TextBlock  Text=" Adet" FontSize="12" FontWeight="SemiBold" ></TextBlock>
                        </StackPanel>


                    </StackPanel>
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Horizontal">

                        <!--<TextBlock Text="{Binding ElementName=furnaceElement,Path=IslemName }" FontSize="12" FontWeight="SemiBold"  TextAlignment="Center" Margin="0 0 0 0" />-->
                        <TextBlock  FontSize="12" FontWeight="SemiBold"  TextAlignment="Center" Margin="0 0 0 0" >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="1">
                                            <Setter Property="Text" Value="SORUN YOK" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>





            </Button>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <!--<Polygon  Points="10,10 30,100 150,150 250,50" Stroke="Black" StrokeThickness="4" Fill="Yellow"  />-->
            <!--<Border Background="White" Width="100" Height="30" BorderBrush="ForestGreen" BorderThickness="2" CornerRadius="5">

            </Border>-->
        </StackPanel>
    </Grid>


</UserControl>
