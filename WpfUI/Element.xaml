<UserControl x:Class="WpfUI.Element"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfUI"
             mc:Ignorable="d" 
             Name="element">

    <Button   Padding="5" Width="90" Margin="1 0" FocusVisualStyle="{x:Null}" Click="Button_Click"  >
        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Height" Value="30"  />
                <Setter Property="Foreground" Value="#E2E2E4" />

                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#464F78"/>
                            <GradientStop Color="#323F6C" Offset="0.9"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5,5,0,0">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#5F76F6" />
                        <Setter Property="Foreground" Value="#ffffff" />
                        <Setter Property="Height" Value="35" />
                    </Trigger>

                    <DataTrigger Binding="{Binding ElementName=element,Path=IsActive}" Value="True">
                        <Setter Property="Background" Value="#5F76F6" />
                        <Setter Property="Foreground" Value="#ffffff" />
                        <Setter Property="Height" Value="35" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Button.Style>

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="{Binding ElementName=element,Path=Title}" FontSize="12" FontWeight="SemiBold" 
                       TextAlignment="Center" Margin="0 0 0 0"/>
        </StackPanel>
    </Button>

</UserControl>
