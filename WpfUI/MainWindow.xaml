<Window x:Class="WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" d:DesignWidth="881.65">
    <!--// Background Grid //-->
    <Grid Background="#23262B">

        <TextBlock Text="R O T A  F U R N A C E"
                   Foreground="#525965"
                   FontFamily="Fonts/#Orbitron Medium"
                   FontSize="15"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Right"
                   Margin="0,0,15,10" />

        <Border Background="#D61734"
                Height="15"
                CornerRadius="3,0,0,3"
                Width="5"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,0,8" />

        <!--// Menu Panel //-->

        <StackPanel Background="#2E333A"
                    Width="230"
                    Orientation="Vertical"
                    HorizontalAlignment="Left" Margin="8,0,0,0">

            <!--// Channel Name //-->

            <Grid Height="50"
                  VerticalAlignment="Top"
                  Margin="0,30,0,0">

                <Border Background="#D61734"
                        Height="30
                        "
                        CornerRadius="3,0,0,3"
                        Width="10  "
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right" />

                <Border Background="#D61734"
                        Height="30
                        "
                        CornerRadius="0,3,3,0"
                        Width="10  "
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left" />

                <TextBlock Text="N A R T "
                           Foreground="#FFFFFF"
                           FontFamily="Fonts/#Orbitron Medium"
                           FontSize="25"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

            </Grid>

            <!--// Main Menu //-->

            <Menu Height="450"
                  Background="Transparent"
                  Margin="0,40,0,0">

                <Menu.ItemsPanel>

                    <ItemsPanelTemplate>

                        <VirtualizingStackPanel Orientation="Vertical" />

                    </ItemsPanelTemplate>

                </Menu.ItemsPanel>

                <!--// Main Menu - Mal KAbul //-->

                <MenuItem Header="Mal Kabul"
                          Name="malkabul"
                          Template="{StaticResource Menu_Template}" Click="malkabul_Click" >

                    <MenuItem.Icon>

                        <Image Source="/img_history.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                 
                </MenuItem>

                <!--// Main Menu - İşlemler //-->

                <MenuItem Header="İşlemler"
                          Name="islemler"
                          Template="{StaticResource Menu_Template}" Click="islemler_Click">

                    <MenuItem.Icon>

                        <Image Source="/img_hotkey.png"
                               Stretch="None" />

                    </MenuItem.Icon>


                </MenuItem>

                <!--// Main Menu - Tanımlar //-->

                <MenuItem Header="Tanımlar"
                          Template="{StaticResource Menu_SubMenu_Template}">

                    <MenuItem.Icon>

                        <Image Source="/img_album.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                    <!--// Tanımlar Submenu - Müşteri //-->

                    <MenuItem Header="Müşteri"
                              Name="musteri"
                              Template="{StaticResource Item_Template}" Click="musteri_Click">

                        <MenuItem.Icon>

                            <Image Source="/img_songs.png"
                                   Stretch="None" />

                        </MenuItem.Icon>

                    </MenuItem>
                    <!--// Tanımlar Submenu - Fiyat //-->
                    <MenuItem Header="Fiyat"
                              Template="{StaticResource Item_Template}"
                              Name="FiyatTanim" Click="FiyatTanim_Click">

                        <MenuItem.Icon>

                            <Image Source="/img_songs.png"
                                   Stretch="None" />

                        </MenuItem.Icon>

                    </MenuItem>
                    <!--// Tanımlar Submenu - Servis //-->

                    <MenuItem Header="Servis"
                              Name="servis"
                              Template="{StaticResource Item_Template}" Click="servis_Click">

                        <MenuItem.Icon>

                            <Image Source="/img_album.png"
                                   Stretch="None" />

                        </MenuItem.Icon>

                    </MenuItem>

                    <!--// Tanımlar Submenu - Malzeme //-->

                    <MenuItem Header="Malzeme"
                              
                              Template="{StaticResource Menu_SubMenu_Template}">

                        <MenuItem.Icon>

                            <Image Source="/img_genre.png"
                                   Stretch="None" />

                        </MenuItem.Icon>
                        <!--// Tanımlar .. Malzeme Submenu - Ekle/Düzenle //-->

                        <MenuItem Header="Ekle"
                                  Name="Menu_MalzemeAdd"
                                  Template="{StaticResource Item_Template}" Click="Menu_MalzemeAdd_Click" >

                            <MenuItem.Icon>

                                <Image Source="/img_rock.png"
                                       Stretch="None" />

                            </MenuItem.Icon>

                        </MenuItem>

                        <!--// Tanımlar .. Malzeme Submenu - Grup Tanımları//-->

                        <MenuItem Header="Grup Ekle"
                                  Name="Menu_MGrup"
                                  Template="{StaticResource Item_Template}" Click="Menu_MGrup_Click">

                            <MenuItem.Icon>

                                <Image Source="/img_pop.png"
                                       Stretch="None" />

                            </MenuItem.Icon>

                        </MenuItem>

                       


                    </MenuItem>

                    <!--// Tanımlar Submenu - Fırınlar //-->

                    <MenuItem Header="Fırınlar"
                              Template="{StaticResource Menu_SubMenu_Template}">

                        <MenuItem.Icon>

                            <Image Source="Assets/img_artist.png"
                                   Stretch="None" />

                        </MenuItem.Icon>
                        <!--// Tanımlar .. Fırınlar Submenu - İşlem Tanımı //-->
                        <MenuItem Header="İşlem Tanımı"
                                  Name="islemaAdd"
                                  Template="{StaticResource Item_Template}" Click="islemaAdd_Click">

                            <MenuItem.Icon>

                                <Image Source="/img_pop.png"
                                       Stretch="None" />

                            </MenuItem.Icon>
                        </MenuItem>
                        <!--// Tanımlar .. Fırınlar Submenu - Bölüm Tanımı //-->
                        <MenuItem Header="Bölüm Tanımı"
                                  Name="bolumislemaAdd"
                                  Template="{StaticResource Item_Template}" Click="bolumislemaAdd_Click">

                            <MenuItem.Icon>

                                <Image Source="/img_pop.png"
                                       Stretch="None" />

                            </MenuItem.Icon>
                        </MenuItem>
                        <!--// Tanımlar .. Fırınlar Submenu - Bölüm Tanımı //-->
                        <MenuItem Header="Fırın Tanımı"
                                  Name="furnace"
                                  Template="{StaticResource Item_Template}" Click="furnace_Click">

                            <MenuItem.Icon>

                                <Image Source="/img_pop.png"
                                       Stretch="None" />

                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>


                </MenuItem>

                <!--// Main Menu - Arama Motoru //-->

                <MenuItem Header="Arama"
                          Template="{StaticResource Menu_Template}">

                    <MenuItem.Icon>

                        <Image Source="/img_search.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                </MenuItem>

                <!--// Main Menu - İstatistik //-->

                <MenuItem Header="İstatistik"
                          Template="{StaticResource Menu_Template}">

                    <MenuItem.Icon>

                        <Image Source="/img_input.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                </MenuItem>

           

             

                <!--// Main Menu - Settings //-->

                <MenuItem Header="Ayarlar"
                          Template="{StaticResource Menu_SubMenu_Template}">

                    <MenuItem.Icon>

                        <Image Source="/img_setting.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                    <!--// Settings Submenu - Input / Codecs //-->

                    <MenuItem Header="Kullanıcı"
                              Template="{StaticResource Item_Template}">

                        <MenuItem.Icon>

                            <Image Source="Assets/img_input.png"
                                   Stretch="None" />

                        </MenuItem.Icon>

                    </MenuItem>

                    <!--// Settings Submenu - Hotkeys //-->

                    <MenuItem Header="Tema"
                              Template="{StaticResource Item_Template}">

                        <MenuItem.Icon>

                            <Image Source="Assets/img_hotkey.png"
                                   Stretch="None" />

                        </MenuItem.Icon>

                    </MenuItem>

                </MenuItem>

                <!--// Main Menu - About //-->

                <MenuItem Header="Hakkında"
                          Template="{StaticResource Menu_Template}">

                    <MenuItem.Icon>

                        <Image Source="/img_about.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                </MenuItem>

                <!--// Main Menu - Exit //-->

                <MenuItem Header="Çıkış"
                          Template="{StaticResource Menu_Template}" Click="MenuItem_Click">

                    <MenuItem.Icon>

                        <Image Source="/img_exit.png"
                               Stretch="None" />

                    </MenuItem.Icon>

                </MenuItem>

            </Menu>

        </StackPanel>

        <!--// Maximize / Minimize App //-->

        <Button x:Name="MaxBtn"
                Style="{StaticResource MaxBtnStyle}"
                Click="MaxBtn_Click" />

        <!--// Close App //-->

        <Button x:Name="CloseBtn"
                Style="{StaticResource CloseBtnStyle}"
                Click="CloseBtn_Click" />

    </Grid>
</Window>
