<Window x:Class="WpfUI.UControls.Win_FurnacePlaning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:WpfUI.UControls.UC_FurnacePlaning"
        xmlns:uce="clr-namespace:WpfUI.Elements"
        xmlns:local="clr-namespace:WpfUI.UControls"
        mc:Ignorable="d"
        Title="Win_FurnacePlaning" Height="455" Width="969">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--başlık-->
        <Border Background="DodgerBlue"  Margin="0,0,0,0" Grid.Row="0" CornerRadius="0,14,0,0">
            <Grid>

                <StackPanel  HorizontalAlignment="Left" Margin="0,0,0,0" Orientation="Horizontal">
                    <Viewbox Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <WrapPanel Width="auto">
                        <Label FontSize="19"   Foreground="#E2E2E4" Content="Fırın Planlama Ekranı" FontWeight="Medium"></Label>
                        <Label FontSize="19"   Foreground="#E2E2E4" Content="MENEVİŞ" FontWeight="Medium"></Label>
                        <Label Margin="20,0,0,0"   VerticalAlignment="Center" FontSize="13"  Foreground="#E2E2E4" Content="BölümAdı / Fırın Adı / İşlem Adı" FontWeight="Light"></Label>
                    </WrapPanel>
                    

                </StackPanel>

                <Button Width="25" Height="25" x:Name="CloseBtn"
                    Style="{StaticResource ExitBtnStyle}" Margin="0,8,8,0" RenderTransformOrigin="0.5,0.5" Click="CloseBtn_Click"  >

                </Button>
            </Grid>
        </Border>
        <!--Ana gövde-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="270"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            <!--Fırın ve Paket Detayları-->
            <Grid Background="DodgerBlue"  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!--Fırın Detayları-->
                <uc:UC_FurnaceTitle Grid.Row="0"/>
                <!--Paket listesi-->
                <!--//Buraya yaz  Grid.Row="1"  -->
            </Grid>
            
            
            <!--Listeler-->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <!--Grid.row=0     ilgili işlemi yapabilecek liste // Örn; Sıradaki işlemi Meneviş işlemi olan tüm malzemeler   -->


                <!--Grid.row=1     Paket içi liste // Örn; Paket-1 de yer alan  malzemeler   -->
                
                
            </Grid>
            
            <!--Fırın Listesi-->
            <Grid Grid.Column="2">
                <uce:FurnaceElement2/>
            </Grid>
        </Grid>
    </Grid>
</Window>
