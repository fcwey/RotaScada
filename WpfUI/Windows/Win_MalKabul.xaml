<Window x:Class="WpfUI.Windows.Win_MalKabul"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI.Windows" xmlns:uc="clr-namespace:WpfUI"
        mc:Ignorable="d"
      Title="Win_Page_MalKabul" Height="1000" Width="1000" WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None">
    <Border BorderBrush="Black" BorderThickness="9" CornerRadius="0,9,0,0">
        <Grid Background="GhostWhite" MouseDown="Grid_MouseDown" >
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="133*"/>
                <RowDefinition Height="271*"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <!--//Üst Menü-->
            <Border Background="DodgerBlue"  Margin="0,0,0,0" Grid.Row="0" CornerRadius="0,10,0,0">
                <Grid>
                    <StackPanel  HorizontalAlignment="Left" Margin="0,0,0,0" Orientation="Horizontal">
                        <Viewbox Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                            <Canvas Width="13.229166" Height="13.229167">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="0" Y="0"/>
                                </Canvas.RenderTransform>
                                <Canvas.Resources/>
                                <!--Unknown tag: sodipodi:namedview-->
                                <!--Unknown tag: metadata-->

                            </Canvas>
                        </Viewbox>
                        <Label FontSize="19"  Foreground="#E2E2E4" Content="Mal Giriş Ekranı" FontWeight="Light"></Label>

                    </StackPanel>

                    <Button Width="25" Height="25" x:Name="CloseBtn"
                    Style="{StaticResource ExitBtnStyle}" Margin="0,8,8,0" RenderTransformOrigin="0.5,0.5" Click="CloseBtn_Click"  >

                    </Button>
                </Grid>
            </Border>
            <!--Firma Ayrıntıları-->
            <Border Margin="15,10,0,0" Grid.Row="1"   >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!--Firma Bilgileri-->
                    <Border Grid.Column="0">

                        <StackPanel  Orientation="Vertical">
                            <Expander x:Name="FirmaExpander" Header="Genel Bilgiler" Background="Gray" Foreground="White" FontSize="15"/>

                            <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,15,0,10">
                                <Label FontSize="13" Content="Firma Adı :"></Label>
                                <TextBox FontWeight="Bold" Foreground="Red" Name="txtFirmaName" FontSize="15" Width="220" KeyDown="txtFirmaName_KeyDown" />
                                <Button x:Name="btnSelect" Background="LightGray" BorderThickness="1" BorderBrush="Gray" Width="30" Click="btnSelect_Click"  >
                                    <Image Source="/Assets/select.png" Width="20" Height="20"/>
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="0,3,3,0"/>
                                        </Style>

                                    </Button.Resources>
                                </Button>
                                <Button x:Name="btnFirmaAdd" Background="	#E5E4E2" Margin="20,0,0,0"  BorderThickness="1" BorderBrush="#7393B3" Width="100" >

                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Firma Ekle"></Label>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,0,0,10">
                                <Label FontSize="13" Content="Firma Not :"></Label>
                                <TextBox Foreground="DodgerBlue" Name="txtFirmaNot" FontSize="15" Width="250" />
                                <Button x:Name="btnFirmaDetail" Background="LightGray" Margin="20,0,0,0"  BorderThickness="1" BorderBrush="Gray" Width="100" >

                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Firma Ayrıntıları"></Label>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1">
                        <StackPanel Orientation="Vertical">
                            <Expander Header="Teslimat" Background="Gray" Foreground="White" FontSize="15"/>
                            <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,15,0,10">
                                <Label FontSize="13" Content="   Giriş Tarihi :"></Label>
                                <DatePicker FontSize="14" SelectedDateFormat="Long" SelectedDate="{x:Static sys:DateTime.Now}"></DatePicker>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,0,0,10">
                                <Label FontSize="13" Content="Teslim Tarihi :"></Label>
                                <DatePicker FontSize="14" SelectedDateFormat="Long" SelectedDate="{x:Static sys:DateTime.Today}"></DatePicker>
                            </StackPanel>
                        </StackPanel>

                    </Border>
                </Grid>

            </Border>
            <Border Grid.Row="2" Grid.RowSpan="2">
                <Grid Margin="0,-18,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="420"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="600"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!--Malzeme Bilgisi-->
                    <Border Padding="5" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Margin="15,0,0,0" Grid.Row="0" Grid.Column="0" >

                        <StackPanel Orientation="Vertical">
                            <Expander Header="Malzeme Bilgileri" Background="LightGray" Foreground="DodgerBlue" FontSize="15"/>
                            <StackPanel Orientation="Horizontal">
                                <ScrollViewer  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" Padding="0 0" VerticalAlignment="Top" Width="{Binding ElementName=grid,Path=ActualWidth}">
                                    <StackPanel Name="stackBolumAdd" Orientation="Horizontal"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">

                                        <uc:Element x:Name="vacum" Title="Vakum Fırınları" IsActive="True" VerticalAlignment="Bottom"/>
                                        <uc:Element x:Name="tuz" Title="Tuz Banyoları"   VerticalAlignment="Bottom"/>
                                        <uc:Element x:Name="ind" Title="İnduksiyon" VerticalAlignment="Bottom"/>
                                        <uc:Element x:Name="ath" Title="Atmosfer Yagda"  VerticalAlignment="Bottom"/>

                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                            <StackPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>

                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="390"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <!--Malzeme Bilgileri ilk yarım-->
                                            <Border Grid.Column="0">
                                                <StackPanel  Orientation="Vertical">
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,15,0,10">
                                                        <Label  FontSize="13" Content="  Malzeme Standart No :"></Label>
                                                        <TextBox Name="txtMalStandartno" FontSize="15" Width="180" KeyDown="txtMalStandartno_KeyDown"/>
                                                        <Button x:Name="btnSelectMalzeme" Background="LightGray" BorderThickness="1" BorderBrush="Gray" Width="30" Click="btnSelectMalzeme_Click"  >
                                                            <Image Source="/Assets/select.png" Width="20" Height="20"/>
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="0,3,3,0"/>
                                                                </Style>

                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,0,0,10">
                                                        <Label FontSize="13" Content="              İstenen Sertlik :"></Label>
                                                        <TextBox Name="txtSertlik" FontSize="15" Width="212" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,0,0,10">
                                                        <Label FontSize="13" Content="İstenen Sertlik Derinliği :"></Label>
                                                        <TextBox Name="txtSertDerin" FontSize="15" Width="212" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,0,0,10">
                                                        <Label FontSize="13" Content="            Malzeme Grubu :"></Label>
                                                        <TextBox IsEnabled="False" Name="txtMalzemeGrubu" FontSize="15" Width="212" />
                                                    </StackPanel>

                                                </StackPanel>
                                            </Border>
                                            <!--Malzeme Bilgileri son yarım Ekle butonu falan-->
                                            <Border  BorderThickness="0.4,0,0,0" BorderBrush="LightGray"  Grid.Column="1">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,15,0,10">
                                                        <Label FontSize="13" Content="  Adet:"></Label>
                                                        <TextBox  Name="txtAdet" FontSize="15" Width="90" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,0,0,10">
                                                        <Label FontSize="13" Content="Ağırlık:"></Label>
                                                        <TextBox  Name="txtAgirlik" FontSize="15" Width="90" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Height="50" Orientation="Horizontal" Margin="5,0,0,10">
                                                        <Button x:Name="btn"  Background="WhiteSmoke" Margin="20,0,0,0"  BorderThickness="1" BorderBrush="#7393B3" Width="100" >

                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="8"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Label Foreground="Black" FontSize="20" Content="Ekle"></Label>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>

                                                </StackPanel>

                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ListView  Grid.Row="1"  FontSize="15" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,10,0,0"  AlternationCount="2" Name="lvMalzeme" Grid.ColumnSpan="7" >
                                        <ListView.View>
                                            <GridView  >
                                                <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding BolumName}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Bölüm Adı" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Width="Auto"   DisplayMemberBinding="{Binding BolumIslemName}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Bölüm İşlem Adı" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding MGrupName}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Malzeme Grup Adı" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Fiyati}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Fiyat" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>

                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                    <!--Malzeme Detay-->
                    <Border Padding="5" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Margin="15,0,0,0" Grid.Row="0" Grid.Column="1">
                        <StackPanel Orientation="Vertical">
                            <Expander Header="Malzeme Detay" Background="Linen" Foreground="DodgerBlue" FontSize="15"/>
                        </StackPanel>

                    </Border>
                    <!--işlem bilgileri-->
                    <Border Padding="5" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Margin="15,10,0,0" Grid.Row="1" Grid.Column="0">
                        <StackPanel Orientation="Vertical">
                            <StackPanel>
                                <Expander Header="İşlem Bilgileri" Background="MintCream" Foreground="DodgerBlue" FontSize="15"/>
                            </StackPanel>
                            <StackPanel >
                                <Grid >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="33*"/>
                                        <ColumnDefinition Width="64*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.ColumnSpan="2">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="390"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0">
                                                <StackPanel Orientation="Vertical">

                                                    <StackPanel Orientation="Horizontal" Margin="10,15,0,10">
                                                        <Label FontSize="13" Content="İstenen İşlem Adı :"></Label>
                                                        <ComboBox  FontSize="15" Foreground="Red" Name="cbxBolumIslem" Width="230"></ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="10,10,0,10">
                                                        <Label FontSize="13" Content="            Not: "></Label>
                                                        <TextBox Name="txtNot" FontSize="13" Width="265" Height="60"
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" ></TextBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border BorderThickness="0.4,0,0,0" BorderBrush="LightGray" Grid.Column="1">
                                                <StackPanel  HorizontalAlignment="Center" Orientation="Vertical">
                                                    <StackPanel VerticalAlignment="Top" Height="30" Orientation="Horizontal" Margin="5,15,0,10">
                                                        <Label FontSize="13" Content="Birim Fiyat:"></Label>
                                                        <TextBox  Name="txtBirimFiyat" FontSize="15" Width="90" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="50" Orientation="Horizontal" Margin="5,0,0,10">
                                                        <Button x:Name="btnAdd"  Background="WhiteSmoke" Margin="20,0,0,0"  BorderThickness="1" BorderBrush="Black" Width="100" >

                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="8"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <StackPanel Orientation="Horizontal" >
                                                                <Label Foreground="Black" FontSize="20" Content="Ekle"></Label>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ListView Grid.Row="1" FontSize="15" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,10,0,0"  AlternationCount="2" Name="lvIslem" Grid.ColumnSpan="2" Grid.RowSpan="2" >
                                        <ListView.View>
                                            <GridView  >
                                                <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding BolumName}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Bölüm Adı" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Width="Auto"   DisplayMemberBinding="{Binding BolumIslemName}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Bölüm İşlem Adı" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding MGrupName}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Malzeme Grup Adı" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>
                                                <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Fiyati}">
                                                    <GridViewColumn.Header>
                                                        <Label Content="Fiyat" FontWeight="Bold"></Label>
                                                    </GridViewColumn.Header>
                                                </GridViewColumn>

                                            </GridView>
                                        </ListView.View>
                                    </ListView>



                                </Grid>
                            </StackPanel>
                        </StackPanel>



                    </Border>
                    <!--fiyat bilgileri-->
                    <Border Padding="5" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Margin="15,10,0,0" Grid.Row="1" Grid.Column="1">
                        <StackPanel Orientation="Vertical">
                            <Expander Header="Fiyat Bilgileri" Background="Bisque" Foreground="Firebrick" FontSize="15"/>
                        </StackPanel>

                    </Border>




                </Grid>
            </Border>
            <!--Alt Menü Butonlar-->
            <Border Grid.Row="4" Background="GhostWhite" BorderBrush="DodgerBlue" BorderThickness="0,0.8,0,0" >
                <StackPanel Orientation="Horizontal" Margin="150,5,0,0">
                    <Button Name="btnYeni"   Margin="5,0,0,0" Grid.Row="1" Height="40" Width="85" Click="btnYeni_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="7,0,0,7"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Margin="-5,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
                                    <!--Unknown tag: sodipodi:namedview-->
                                    <!--Unknown tag: metadata-->
                                    <Canvas >
                                        <Polygon xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Points="321.055,82.36 327.055,82.36 327.055,78.36 321.055,78.36 321.055,72.36 317.055,72.36 317.055,78.36 311.055,78.36 311.055,82.36 317.055,82.36 317.055,88.36 321.055,88.36 " Name="polygon260" FillRule="NonZero" Fill="#FF07A000">
                                            <Polygon.RenderTransform>
                                                <MatrixTransform Matrix="0.54511253 0 0 0.54511253 -167.18819 -37.308778"/>
                                            </Polygon.RenderTransform>
                                        </Polygon>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label FontSize="15" VerticalAlignment="Center"  Padding="0" Content="Yeni"></Label>
                        </StackPanel>


                    </Button>

                    <Button Name="btnSil"  Margin="40,0,0,0" Grid.Row="1" Height="40" Width="95" Click="btnSil_Click" >
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Margin="-3,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
                                    <!--Unknown tag: sodipodi:namedview-->
                                    <!--Unknown tag: metadata-->
                                    <Canvas Name="layerl1">
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path206" Fill="#FFD8210D" StrokeThickness="0.571688">
                                            <Path.Data>
                                                <PathGeometry Figures="M 8.0319945 2.6127604 V 2.0410715 H 5.1735492 V 2.6127604 H 2.3151042 V 3.7561385 H 10.890439 V 2.6127604 Z m -5.1452014 1.715067 v 5.1452005 c 0 0.9490041 0.7660633 1.7150671 1.715067 1.7150671 h 4.0018234 c 0.949003 0 1.7150665 -0.766063 1.7150665 -1.7150671 V 4.3278274 H 9.1753725 v 5.1452005 c 0 0.31443 -0.25726 0.5716901 -0.571689 0.5716901 H 4.6018601 c -0.3144289 0 -0.5716889 -0.2572601 -0.5716889 -0.5716901 V 4.3278274 Z m 1.715067 0.5716891 V 9.4730279 H 5.1735492 V 4.8995165 Z m 1.143378 0 v 4.5735114 h 0.571689 V 4.8995165 Z m 1.1433781 0 V 9.4730279 H 7.4603055 V 4.8995165 Z m 1.1433783 0 v 4.5735114 h 0.571689 V 4.8995165 Z" FillRule="EvenOdd"/>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label FontSize="15" VerticalAlignment="Center" Padding="0" Content=" Sil"></Label>
                        </StackPanel>
                    </Button>
                    <Button  Name="btnKaydet"  Margin="40,0,0,0" Grid.Row="1" Height="40" Width="295" Click="btnKaydet_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Margin="-3,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
                                    <!--Unknown tag: sodipodi:namedview-->
                                    <!--Unknown tag: metadata-->
                                    <Canvas >
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path84" Fill="#FF007ACC" StrokeThickness="0.585876">
                                            <Path.Data>
                                                <PathGeometry Figures="M 10.185684 4.6457637 8.3343142 2.8705576 9.1193887 2.1206354 10.970759 3.9134178 Z M 5.0944164 9.7018786 3.3719392 7.9794014 7.7660137 3.4740104 9.6701128 5.1437587 Z m -2.32593 0.6034534 V 8.5652781 l 1.7400535 1.7400539 z" FillRule="EvenOdd"/>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label x:Name="LabelKaydet" FontSize="15" VerticalAlignment="Center" Padding="0" Content="Kaydet"></Label>
                        </StackPanel>
                    </Button>
                    <Button Name="btnExit" BorderBrush="#EF9999" Margin="40,0,0,0" Grid.Row="1" Height="40" Width="85"  Background="#E47474" Click="btnExit_Click">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="0,7,7,0"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="25" Height="25" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
                                    <!--Unknown tag: sodipodi:namedview-->
                                    <!--Unknown tag: metadata-->
                                    <Canvas >
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path52" Fill="White" StrokeThickness="0.61776">
                                            <Path.Data>
                                                <PathGeometry Figures="M 7.3663172 6.4158114 V 2.0914853 h -1.235523 v 4.3243261 z m -4.9420881 0.617761 c 0 2.3907347 1.9335911 4.3243256 4.3243261 4.3243256 2.390735 0 4.3243268 -1.9335909 4.3243268 -4.3243256 0 -1.7235528 -1.013128 -3.2123565 -2.4710448 -3.9104263 v 1.4393827 c 0.747491 0.5621625 1.235523 1.4579157 1.235523 2.4710436 0 1.7050197 -1.383785 3.0888046 -3.088805 3.0888046 -1.70502 0 -3.0888045 -1.3837849 -3.0888045 -3.0888046 0 -1.0131279 0.4880315 -1.9088811 1.2355215 -2.4710436 V 3.1231461 C 3.4373568 3.8212159 2.4242291 5.3100196 2.4242291 7.0335724 Z" FillRule="EvenOdd"/>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label FontSize="15" VerticalAlignment="Center" Padding="0" Content="Çıkış"></Label>
                        </StackPanel>

                    </Button>

                </StackPanel>
            </Border>
            <!--Alt Bilgi-->
            <Border Grid.Row="5" Background="#FF007ACC" Height="40" VerticalAlignment="Center" Grid.ColumnSpan="4" CornerRadius="0,0,0,10">
                <Grid>
