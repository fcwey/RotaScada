<UserControl x:Class="WpfUI.Windows.PopupUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfUI.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400">

    <Grid>

        <!--draw the popup user control-->
        <!--<Path x:Name="Container"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="M0,0
                    L10,-10 10,-27
                    C10,-27 10,-32 18,-32
              
                    L198,-32
                    C208,-31 208,-25 208,-15
              
                    L208,0 208,20
                    C208,30 205,33 195,33
              
                    L20,33
                    C15,33 10,33 10,25
              
                    L10,10
                    z"            
              Fill="#3A6180"
              Height="30"
              Width="400"
              Stroke="#3A6180"
              Stretch="Fill"/>-->

        <!--reusable text-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20">

            </ColumnDefinition>
            <ColumnDefinition>

            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Grid.Column="0">
            <StackPanel  VerticalAlignment="Center" Orientation="Vertical">
                <Image Width="20" Height="20" x:Name="PopupImage"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
                </Image>
            </StackPanel>
     
        </StackPanel>





        <TextBlock Grid.Column="1" x:Name="PopupText"
                   FontSize="14"
                   Panel.ZIndex="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center">

        </TextBlock>

    </Grid>

    <!--animate the user control-->
    <UserControl.Style>
        <Style>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="00:00:01" From="0.2" To="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="FrameworkElement.Visibility" Value="Collapsed">
                    <Setter Property="FrameworkElement.Opacity" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

</UserControl>
