<Window x:Class="WpfUI.Windows.Win_MalKabul_List_Malzeme"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI.Windows"
        mc:Ignorable="d"
     Title="WindowMalzeme" Height="550" Width="400" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40">

            </RowDefinition >
            <RowDefinition Height="60">

            </RowDefinition>
            <RowDefinition>

            </RowDefinition>
            <RowDefinition Height="42">


            </RowDefinition>
        </Grid.RowDefinitions>
        <Border Background="Firebrick"  Margin="0,0,0,0" Grid.Row="0" CornerRadius="0,14,0,0" Loaded="Border_Loaded" >
            <Grid>



                <StackPanel  HorizontalAlignment="Left" Margin="0,0,0,0" Orientation="Horizontal">
                    <Viewbox Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <Label FontSize="19"  Foreground="White" Content="Malzeme Listesi" FontWeight="Light"></Label>

                </StackPanel>

                <Button Width="25" Height="25" x:Name="CloseBtn"
                    Style="{StaticResource ExitBtnStyle}" Margin="0,8,8,0" RenderTransformOrigin="0.5,0.5" Click="CloseBtn_Click"  >

                </Button>
            </Grid>

        </Border>
        <!--Butonlar-textbox  vs-->
        <Border BorderThickness="5,0,5,0" BorderBrush="Firebrick" Background="White" Margin="0,0,0,0" Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" Orientation="Vertical" Margin="0,0,0,0">
                <!--Malzeme Grup Textbox ve Label-->
                <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
                    <Label FontSize="13" Content="Arama:"></Label>
                    <TextBox Name="txtFilter" FontSize="20" Width="250" TextChanged="txtFilter_TextChanged"></TextBox>

                </StackPanel>

            </StackPanel>
        </Border>
        <!--Listview Sayfası-->


        <ListView  BorderThickness="5,0,5,0" BorderBrush="Firebrick" Grid.Row="2" FontSize="15" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0"  AlternationCount="2" Name="lvMGrup" Grid.ColumnSpan="7" MouseDoubleClick="lvMGrup_MouseDoubleClick">
            <ListView.View>

                <GridView  >


                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding MalzemeName}">
                        <GridViewColumn.Header>
                            <Label Content="Malzeme Adı" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

        <!--Alt Bilgi Border-->
        <Border Grid.Row="3" Background="Firebrick" Height="40" VerticalAlignment="Center" Grid.ColumnSpan="4" CornerRadius="0,0,0,10">
            <Grid>
                <StackPanel  HorizontalAlignment="Left" Margin="10,0,0,0" Orientation="Horizontal">
                    <Viewbox x:Name="Message" Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>

                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <!--<Label VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="Message" FontSize="10" Foreground="White" Content="v1.0" FontWeight="Light">
                      
                        
                    </Label>-->


                </StackPanel>
                <StackPanel Orientation="Vertical">

                </StackPanel>
                <StackPanel  HorizontalAlignment="Right" Margin="0,0,10,0"  Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13" Height="13">

                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->
                            <Canvas >
                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path16" Fill="YellowGreen" StrokeThickness="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Top="-4" Canvas.Left="0">
                                    <Path.Data>
