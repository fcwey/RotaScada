                                </TextBlock>
                            </ToolTip>
                        </TextBlock.ToolTip>
                </TextBlock>
                </StatusBarItem>
            </StatusBar>
        </Border>-->
        <Grid>
            <Popup x:Name="popup_uc"
                   AllowsTransparency="True"
                   HorizontalOffset="10"
                   VerticalOffset="10">
                <Grid>
                    <local:PopupUC x:Name="Header" Foreground="#E0FFFF"/>
                </Grid>
            </Popup>
        </Grid>
    </Grid>
</Window>
