                                                            <Polygon.RenderTransform>
                                                                <MatrixTransform Matrix="0.54511253 0 0 0.54511253 -167.18819 -37.308778"/>
                                                            </Polygon.RenderTransform>
                                                        </Polygon>
                                                    </Canvas>
                                                </Canvas>
                                            </Viewbox>
                                            <Label FontSize="15" VerticalAlignment="Center"  Padding="0" Content="Yeni"></Label>
                                        </StackPanel>


                                    </Button>
                                    <Button  Name="btnKaydet"  Margin="20,0,0,0" Grid.Row="1" Height="40" Width="95" Click="btnKaydet_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Margin="-3,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                                <Canvas Width="13.229166" Height="13.229167">
                                                    <Canvas.RenderTransform>
                                                        <TranslateTransform X="0" Y="0"/>
                                                    </Canvas.RenderTransform>
                                                    <Canvas.Resources/>
                                                    <!--Unknown tag: sodipodi:namedview-->
                                                    <!--Unknown tag: metadata-->
                                                    <Canvas >
                                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path84" Fill="#FF007ACC" StrokeThickness="0.585876">
                                                            <Path.Data>
                                                                <PathGeometry Figures="M 10.185684 4.6457637 8.3343142 2.8705576 9.1193887 2.1206354 10.970759 3.9134178 Z M 5.0944164 9.7018786 3.3719392 7.9794014 7.7660137 3.4740104 9.6701128 5.1437587 Z m -2.32593 0.6034534 V 8.5652781 l 1.7400535 1.7400539 z" FillRule="EvenOdd"/>
