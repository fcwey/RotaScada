                <Border Grid.Column="1" Background="AliceBlue">
                    <StackPanel VerticalAlignment="Top" Orientation="Vertical" >
                        <StackPanel Margin="20"  Orientation="Vertical"  Height="auto">
                            <TextBlock Margin="15" Foreground="Black" FontSize="20" Text="BOŞALTMA ALANI"></TextBlock>
                        </StackPanel>
                        <StackPanel  Margin="5">
                            <TextBlock  Margin="50,2" Foreground="Black" FontSize="20" Text="FIRIN LİSTESİ"></TextBlock>
                            <Border Background="Black" Width="auto" Height="2"></Border>
                            <ScrollViewer  BorderThickness="0" Background="Transparent" BorderBrush="Transparent" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" >

                                
                                <ListBox VirtualizingStackPanel.IsVirtualizing="False" BorderThickness="0"  Background="Transparent" Name="lbfurnace"   >
                                   
