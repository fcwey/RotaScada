<Window x:Class="WpfUI.Windows.Win_IslemTakip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI.Windows" xmlns:uc="clr-namespace:WpfUI"
        mc:Ignorable="d"
        Title="Win_IslemTakip"  Height="1000" Width="1000" WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <!--//Üst Menü-->
        <Border Background="DodgerBlue"  Margin="0,0,0,0" Grid.Row="0" CornerRadius="0,10,0,0">
            <Grid>
                <StackPanel  HorizontalAlignment="Left" Margin="0,0,0,0" Orientation="Horizontal">
                    <Viewbox Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <Label FontSize="19"  Foreground="#E2E2E4" Content="İŞLEM TAKİP EKRANI" FontWeight="Medium"></Label>

                </StackPanel>

                <Button Width="25" Height="25" x:Name="CloseBtn"
                    Style="{StaticResource ExitBtnStyle}" Margin="0,8,8,0" RenderTransformOrigin="0.5,0.5" Click="CloseBtn_Click"  >

                </Button>
            </Grid>
        </Border>
        <!--orta menü-->
        <Border Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="AliceBlue">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition/>
                            <RowDefinition Height="100"/>
                        </Grid.RowDefinitions>
                        <!--bölümler tab menü vakum-tuz -ind  arama listeleme falan  -->
                        <Border Grid.Row="0" Margin="15,15,0,0">
                            <StackPanel Orientation="Vertical" >
                                <StackPanel Orientation="Horizontal">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" >
                                        <ListBox Background="Transparent" BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="False" Name="lbx" SelectionChanged="lbx_SelectionChanged"   >
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <Border x:Name="Bd"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="true">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="Selector.IsSelectionActive"
                                            Value="False" />
                                                                            <Condition Property="IsSelected"
                                            Value="True" />
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter Property="Background"
                                    TargetName="Bd"
                                    Value="Transparent" />
                                                                    </MultiTrigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="Selector.IsSelectionActive"
                                            Value="True" />
                                                                            <Condition Property="IsSelected"
                                            Value="True" />
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter Property="Background"
                                    TargetName="Bd"
                                    Value="Transparent" />
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.Resources>

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel  />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>

                                                <DataTemplate>
                                                    <!--<TextBlock Text="{Binding Name}" />-->
                                                    <StackPanel>
                                                        <uc:Element Title="{Binding Name}"  GotFocus="AGotFocus"   IsActive="{Binding Path=IsSelected,
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"  />
                                                    </StackPanel>

                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <Expander Header="Arama Kriterleri" Background="LightGray" Foreground="DodgerBlue" FontSize="15"/>
                                    <Label FontSize="15" Content="Arama koşulları ve butonları konulacak"></Label>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!--Başlıklar stok giriş, işlemdei kalite kontrol, stok çıkış, hepsi-->
                        <Border Grid.Row="1"  Margin="15,15,0,0">
                            <StackPanel Orientation="Vertical" >
                                <StackPanel Orientation="Horizontal">
                                    <ScrollViewer  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" Padding="0 0" VerticalAlignment="Top" Width="{Binding ElementName=grid,Path=ActualWidth}">
                                        <StackPanel Name="stackislemAdd" Orientation="Horizontal"  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">

                                            <uc:Element x:Name="stokGiris" Title="STOK-GİRİŞ" IsActive="True" VerticalAlignment="Bottom"/>
                                            <uc:Element x:Name="islemde" Title="İŞLEMDE"   VerticalAlignment="Bottom"/>
                                            <uc:Element x:Name="kaliteKontrol" Title="KALİTE KONTROL" VerticalAlignment="Bottom"/>
                                            <uc:Element x:Name="stokCikis" Title="STOK-ÇIKIŞ"  VerticalAlignment="Bottom"/>
                                            <uc:Element x:Name="hepsi" Title="HEPSİ"  VerticalAlignment="Bottom" />

                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                        <!--işlem Listesi-->
                        <ListView Grid.Row="2"  FontSize="15" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0"  AlternationCount="2" Name="lvMGrup" Grid.ColumnSpan="7" >
                            <ListView.View>
                                <GridView  >
                                    <!--<GridViewColumn Width="Auto"      DisplayMemberBinding="{Binding Id}">
                        <GridViewColumn.Header>
                            <Label Content="No" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>-->
                                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding BolumName}">
                                        <GridViewColumn.Header>
                                            <Label Content="Bölüm Adı" FontWeight="Bold"></Label>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="Auto"   DisplayMemberBinding="{Binding BolumIslemName}">
                                        <GridViewColumn.Header>
                                            <Label Content="Bölüm İşlem Adı" FontWeight="Bold"></Label>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding MGrupName}">
                                        <GridViewColumn.Header>
                                            <Label Content="Malzeme Grup Adı" FontWeight="Bold"></Label>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Fiyati}">
                                        <GridViewColumn.Header>
                                            <Label Content="Fiyat" FontWeight="Bold"></Label>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                </GridView>
                            </ListView.View>
                        </ListView>
                        <!--planlama ekranı-->

                    </Grid>

                </Border>
                <Border Grid.Column="1" Background="Firebrick">

                </Border>
            </Grid>
        </Border>
        <!--ALT MENU-->
        <Border Grid.Row="2" Background="#FF007ACC" Height="40" VerticalAlignment="Center" Grid.ColumnSpan="4" CornerRadius="0,0,0,10">
            <Grid>
                <StackPanel  HorizontalAlignment="Left" Margin="10,0,0,0" Orientation="Horizontal">
                    <Viewbox x:Name="Message" Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform" VerticalAlignment="Top">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>

                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <!--<Label VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="Message" FontSize="10" Foreground="White" Content="v1.0" FontWeight="Light">
                      
                        
                    </Label>-->


                </StackPanel>
                <StackPanel Orientation="Vertical">

                </StackPanel>
                <StackPanel  HorizontalAlignment="Right" Margin="0,0,10,0"  Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13" Height="13">

                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->
                            <Canvas >
                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path16" Fill="YellowGreen" StrokeThickness="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Top="-4" Canvas.Left="0">
                                    <Path.Data>
                                        <PathGeometry Figures="M 10.021094 8.6137231 C 9.4724137 8.3393833 8.6773887 7.678728 7.4904487 7.4603759 c 0.291136 -0.3527226 0.526285 -0.9014022 0.772631 -1.5396622 0.123172 -0.3863153 0.100777 -0.7054454 0.100777 -1.1533472 0 -0.3415253 0.06719 -0.8678098 -0.02239 -1.1757422 C 8.0839187 2.589444 7.4232641 2.3151042 6.6506335 2.3151042 c -0.7838282 0 -1.4444833 0.2743398 -1.7020268 1.2765201 -0.078383 0.3079324 -0.022394 0.8454146 -0.022394 1.1757422 0 0.4479018 -0.022394 0.7670319 0.1231722 1.1533472 0.2351493 0.63826 0.4591002 1.1981372 0.7614339 1.5396622 C 4.6350748 7.6899257 3.8288516 8.3505807 3.302567 8.6137231 2.1828125 9.1400075 2.1828125 9.7222805 2.1828125 9.7222805 v 0.22395 c 0 0.3807165 0.4143092 0.7670315 0.8174208 0.7670315 H 10.31223 c 0.515087 0 0.828618 -0.419908 0.828618 -0.8006235 v -0.190358 c 0 0 -0.01119 -0.582272 -1.119754 -1.1085574 z" FillRule="EvenOdd"/>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <Label FontSize="12" Foreground="White" Content="Kullanıcı Adı" FontWeight="Light"></Label>
                </StackPanel>
            </Grid>

        </Border>

    </Grid>
</Window>
