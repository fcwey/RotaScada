        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI.Windows"
        xmlns:uc="clr-namespace:WpfUI.Elements"
         xmlns:ucFurn="clr-namespace:WpfUI.Elements"
        mc:Ignorable="d"
        Title="Win_IslemTakip"  Height="1000" Width="1000" WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <!--//Üst Menü-->
        <Border Background="DodgerBlue"  Margin="0,0,0,0" Grid.Row="0" CornerRadius="0,10,0,0">
            <Grid>
                <StackPanel  HorizontalAlignment="Left" Margin="0,0,0,0" Orientation="Horizontal">
                    <Viewbox Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <Label FontSize="19"  Foreground="#E2E2E4" Content="İŞLEM TAKİP EKRANI" FontWeight="Medium"></Label>

                </StackPanel>

                <Button Width="25" Height="25" x:Name="CloseBtn"
                    Style="{StaticResource ExitBtnStyle}" Margin="0,8,8,0" RenderTransformOrigin="0.5,0.5" Click="CloseBtn_Click"  >

                </Button>
            </Grid>
        </Border>
        <!--orta menü-->
        <Border Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="AliceBlue">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="100"/>
                        </Grid.RowDefinitions>
                        <!--bölümler tab menü vakum-tuz -ind  arama listeleme falan  -->
                        <Border Grid.Row="0" Margin="15,15,0,0">
                            <StackPanel Orientation="Vertical" >
                                <StackPanel Orientation="Horizontal">
                                    <!--Bölümler; vakum Tuz falan filan-->
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Auto" >
                                        <ListBox Background="Transparent" BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="False" Name="lbx" SelectionChanged="lbx_SelectionChanged"   >
                                            <ListBox.Resources>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <Border x:Name="Bd"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="true">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="Selector.IsSelectionActive"
                                                                                        Value="False" />
                                                                            <Condition Property="IsSelected"
                                                                                       Value="True" />
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter Property="Background"  TargetName="Bd"  Value="Transparent" />
                                                                    </MultiTrigger>
                                                                    <MultiTrigger>
                                                                        <MultiTrigger.Conditions>
                                                                            <Condition Property="Selector.IsSelectionActive" Value="True" />
                                                                            <Condition Property="IsSelected" Value="True" />
                                                                        </MultiTrigger.Conditions>
                                                                        <Setter Property="Background" TargetName="Bd" Value="Transparent" />
                                                                    </MultiTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.Resources>

                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>

                                                <DataTemplate >
                                                    <!--<TextBlock Text="{Binding Name}" />-->
                                                    <StackPanel>
                                                        <!--<uc:PaketElement   Title="{Binding Name}"  GotFocus="AGotFocus"   IsActive="{Binding Path=IsSelected,
                                    RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}"  />-->
                                                    </StackPanel>

                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <Expander Header="Arama Kriterleri" Background="LightGray" Foreground="DodgerBlue" FontSize="15"/>
                                    <Label FontSize="15" Content="Arama koşulları ve butonları konulacak"></Label>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!--Başlıklar stok giriş, işlemdei kalite kontrol, stok çıkış, hepsi-->
