<Window  x:Class="WpfUI.Windows.Win_IslemTakip_FurnaceMalzemeList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfUI.Windows" xmlns:uc="clr-namespace:WpfUI"
        mc:Ignorable="d"
     Title="WindowMGrup" Height="700" Width="850" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" Background="Transparent" WindowStyle="None">
    <Grid MouseDown="Grid_MouseDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40">

            </RowDefinition >
            <RowDefinition Height="50">

            </RowDefinition >
            <RowDefinition >

            </RowDefinition>
            <RowDefinition Height="60">

            </RowDefinition>
            
            <RowDefinition Height="42">


            </RowDefinition>
        </Grid.RowDefinitions>
        <Border Background="DodgerBlue"  Margin="0,0,0,0" Grid.Row="0" CornerRadius="0,14,0,0">
            <Grid>



                <StackPanel  HorizontalAlignment="Left" Margin="0,0,0,0" Orientation="Horizontal">
                    <Viewbox Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <Label FontSize="19"  Foreground="#E2E2E4" Content="Fırın Malzeme Listesi" FontWeight="Light"></Label>

                </StackPanel>

                <Button Width="25" Height="25" x:Name="CloseBtn"
                    Style="{StaticResource ExitBtnStyle}" Margin="0,8,8,0" RenderTransformOrigin="0.5,0.5" Click="CloseBtn_Click"  >

                </Button>
            </Grid>

        </Border>

        <!--Bölüm başlıkları-->
        <Grid x:Name="grid" Background="White" Margin="0,0,0,0" Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                
                <StackPanel Orientation="Horizontal" >
                    <Label VerticalAlignment="Center" FontSize="15" Content="FIRIN ADI: "></Label>
                    <TextBlock Name="TbFurnaceName" FontSize="18" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"  ></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="50,0,0,0">
                    <Label VerticalAlignment="Center" FontSize="15" Content="YAPILAN İŞLEM ADI: "></Label>
                    <TextBlock Name="TbIslemName" VerticalAlignment="Center" Text="-" FontSize="15" ></TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="50,0,0,0">
                    <Label VerticalAlignment="Center" FontSize="15" Content="DERECE: "></Label>
                    <TextBox Name="tbxDerece" FontSize="15" Width="100" Height="30"></TextBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="50,0,0,0">
                    <Label VerticalAlignment="Center" FontSize="15" Content="DAKİKA: "></Label>
                    <TextBox Name="tbxDakika" FontSize="15" Width="100" Height="30"></TextBox>
                </StackPanel>
            </StackPanel>
        </Grid>
        <ListView Name="lvTakipListe" Grid.Row="2"  FontSize="15" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" Margin="0,0,0,0"  AlternationCount="2"  Grid.ColumnSpan="7" >
            <ListView.View>
                <GridView  >
                    <!--<GridViewColumn Width="Auto"      DisplayMemberBinding="{Binding Id}">
                        <GridViewColumn.Header>
                            <Label Content="No" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>-->
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding FirmaAdi}">
                        <GridViewColumn.Header>
                            <Label Content="Firma Adı" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"   DisplayMemberBinding="{Binding GirisTarihi}">
                        <GridViewColumn.Header>
                            <Label Content="Giriş Tarihi" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding MGrupAdi}">
                        <GridViewColumn.Header>
                            <Label Content="Malzeme Grup Adı" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding MalzemeAdi}">
                        <GridViewColumn.Header>
                            <Label Content="Malzeme Kodu" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding IstenenSertlik}">
                        <GridViewColumn.Header>
                            <Label Content="İstenen Sertlik" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Agirlik}">
                        <GridViewColumn.Header>
                            <Label Content="Ağırlık" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Adet}">
                        <GridViewColumn.Header>
                            <Label Content="Adet" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Durum}">
                        <GridViewColumn.Header>
                            <Label Content="Durum" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding Nerede}">
                        <GridViewColumn.Header>
                            <Label Content="Bulunduğu Yer" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn Width="Auto"  DisplayMemberBinding="{Binding IslemBaslik}">
                        <GridViewColumn.Header>
                            <Label Content="İşlem Adı" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                    </GridViewColumn>
                    <GridViewColumn  Width="Auto"  >
                        <GridViewColumn.Header>
                            <Label Content="Seç" FontWeight="Bold"></Label>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!--<CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}, Mode=TwoWay, Path=IsSelected}" />-->
                                <CheckBox x:Name="ckbReferralIsChecked" Content="{Binding Value}" IsChecked="{Binding IsSelected}"
                                                          Command="{Binding DataContext.CheckBoxIsChecked, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                          CommandParameter="{Binding}">
                                </CheckBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
        <!--Butonlar-textbox  vs-->
        <Border Background="White" Margin="0,0,0,0" Grid.Row="3">
            <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Margin="0,0,0,0">
                <!--Malzeme Grup Textbox ve Label-->

               


                <!--Yeni Kaydet Sil Kapat Butonları-->
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="40,10,0,0">
                    <Button Name="btnIslemDelete"   Margin="5,0,0,0" Grid.Row="1" Height="40" Width="100" >
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="7,0,0,7"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Margin="-5,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
                                    <!--Unknown tag: sodipodi:namedview-->
                                    <!--Unknown tag: metadata-->
                                    <Canvas >
                                        <Polygon xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Points="321.055,82.36 327.055,82.36 327.055,78.36 321.055,78.36 321.055,72.36 317.055,72.36 317.055,78.36 311.055,78.36 311.055,82.36 317.055,82.36 317.055,88.36 321.055,88.36 " Name="polygon260" FillRule="NonZero" Fill="#FF07A000">
                                            <Polygon.RenderTransform>
                                                <MatrixTransform Matrix="0.54511253 0 0 0.54511253 -167.18819 -37.308778"/>
                                            </Polygon.RenderTransform>
                                        </Polygon>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label FontSize="15" VerticalAlignment="Center"  Padding="0" Content="İşlemi  Sil"></Label>
                        </StackPanel>


                    </Button>
                    <Button  Name="btnKaydet"  Margin="20,0,0,0" Grid.Row="1" Height="40" Width="150
                             ">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Margin="-3,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
