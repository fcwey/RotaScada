                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label x:Name="LabelKaydt" FontSize="15" VerticalAlignment="Center" Padding="0" Content="İşlemi başlat "></Label>
                        </StackPanel>
                    </Button>
                    <Button Name="btnSil"  Margin="20,0,0,0" Grid.Row="1" Height="40" Width="95"  >
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Margin="-3,0,0,0" Width="30" Height="30" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                                <Canvas Width="13.229166" Height="13.229167">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform X="0" Y="0"/>
                                    </Canvas.RenderTransform>
                                    <Canvas.Resources/>
                                    <!--Unknown tag: sodipodi:namedview-->
                                    <!--Unknown tag: metadata-->
                                    <Canvas Name="layerl1">
                                        <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  Fill="#FFD8210D" StrokeThickness="0.571688">
                                            <Path.Data>
                                                <PathGeometry Figures="M 8.0319945 2.6127604 V 2.0410715 H 5.1735492 V 2.6127604 H 2.3151042 V 3.7561385 H 10.890439 V 2.6127604 Z m -5.1452014 1.715067 v 5.1452005 c 0 0.9490041 0.7660633 1.7150671 1.715067 1.7150671 h 4.0018234 c 0.949003 0 1.7150665 -0.766063 1.7150665 -1.7150671 V 4.3278274 H 9.1753725 v 5.1452005 c 0 0.31443 -0.25726 0.5716901 -0.571689 0.5716901 H 4.6018601 c -0.3144289 0 -0.5716889 -0.2572601 -0.5716889 -0.5716901 V 4.3278274 Z m 1.715067 0.5716891 V 9.4730279 H 5.1735492 V 4.8995165 Z m 1.143378 0 v 4.5735114 h 0.571689 V 4.8995165 Z m 1.1433781 0 V 9.4730279 H 7.4603055 V 4.8995165 Z m 1.1433783 0 v 4.5735114 h 0.571689 V 4.8995165 Z" FillRule="EvenOdd"/>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                            <Label FontSize="15" VerticalAlignment="Center" Padding="0" Content=" Yazdır"></Label>
                        </StackPanel>
                    </Button>
                    <Button Name="btnAllSelect"  Margin="20,0,0,0" Grid.Row="1" Height="40" Width="95"  >
                        <StackPanel Orientation="Horizontal">

                            <Label FontSize="15" VerticalAlignment="Center" Padding="0" Content="Tümünü Seç"></Label>
                        </StackPanel>
                    </Button>
                    <Button Name="btnNoSelect"  Margin="20,0,0,0" Grid.Row="1" Height="40" Width="95"  >
                        <StackPanel Orientation="Horizontal">

                            <Label FontSize="15" VerticalAlignment="Center" Padding="0" Content="Vazgeç"></Label>
                        </StackPanel>
                    </Button>


                </StackPanel>
            </StackPanel>
        </Border>
        <!--Listview Sayfası-->

       
        <!--Alt Bilgi Border-->
        <Border Grid.Row="4" Background="#FF007ACC" Height="40" VerticalAlignment="Center" Grid.ColumnSpan="4" CornerRadius="0,0,0,10">
            <Grid>
                <StackPanel  HorizontalAlignment="Left" Margin="10,0,0,0" Orientation="Horizontal">
                    <Viewbox x:Name="Message" Width="22" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform" VerticalAlignment="Top">
                        <Canvas Width="13.229166" Height="13.229167">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>

                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->

                        </Canvas>
                    </Viewbox>
                    <!--<Label VerticalAlignment="Center" HorizontalAlignment="Right" x:Name="Message" FontSize="10" Foreground="White" Content="v1.0" FontWeight="Light">
                      
                        
                    </Label>-->


                </StackPanel>
                <StackPanel Orientation="Vertical">

                </StackPanel>
                <StackPanel  HorizontalAlignment="Right" Margin="0,0,10,0"  Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                        <Canvas Width="13" Height="13">

                            <Canvas.RenderTransform>
                                <TranslateTransform X="0" Y="0"/>
                            </Canvas.RenderTransform>
                            <Canvas.Resources/>
                            <!--Unknown tag: sodipodi:namedview-->
                            <!--Unknown tag: metadata-->
                            <Canvas >
                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path16" Fill="YellowGreen" StrokeThickness="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Top="-4" Canvas.Left="0">
                                    <Path.Data>
                                        <PathGeometry Figures="M 10.021094 8.6137231 C 9.4724137 8.3393833 8.6773887 7.678728 7.4904487 7.4603759 c 0.291136 -0.3527226 0.526285 -0.9014022 0.772631 -1.5396622 0.123172 -0.3863153 0.100777 -0.7054454 0.100777 -1.1533472 0 -0.3415253 0.06719 -0.8678098 -0.02239 -1.1757422 C 8.0839187 2.589444 7.4232641 2.3151042 6.6506335 2.3151042 c -0.7838282 0 -1.4444833 0.2743398 -1.7020268 1.2765201 -0.078383 0.3079324 -0.022394 0.8454146 -0.022394 1.1757422 0 0.4479018 -0.022394 0.7670319 0.1231722 1.1533472 0.2351493 0.63826 0.4591002 1.1981372 0.7614339 1.5396622 C 4.6350748 7.6899257 3.8288516 8.3505807 3.302567 8.6137231 2.1828125 9.1400075 2.1828125 9.7222805 2.1828125 9.7222805 v 0.22395 c 0 0.3807165 0.4143092 0.7670315 0.8174208 0.7670315 H 10.31223 c 0.515087 0 0.828618 -0.419908 0.828618 -0.8006235 v -0.190358 c 0 0 -0.01119 -0.582272 -1.119754 -1.1085574 z" FillRule="EvenOdd"/>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <Label FontSize="12" Foreground="White" Content="Kullanıcı Adı" FontWeight="Light"></Label>
                </StackPanel>
            </Grid>

        </Border>

        <Grid>
            <Popup x:Name="popup_uc"
                   AllowsTransparency="True"
                   HorizontalOffset="10"
                   VerticalOffset="10">
                <Grid>
                    <local:PopupUC x:Name="Header" Foreground="#E0FFFF"/>
                </Grid>
            </Popup>
        </Grid>
    </Grid>
</Window>
