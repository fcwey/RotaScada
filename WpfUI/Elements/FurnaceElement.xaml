<UserControl x:Class="WpfUI.Elements.FurnaceElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfUI.Elements"
             mc:Ignorable="d" 
             Name="furnaceElement"
             d:DesignHeight="70" d:DesignWidth="350">
    <Canvas >
        <Button  Width="348" FocusVisualStyle="{x:Null}" Click="Button_Click" HorizontalAlignment="Center" Canvas.Left="5" Canvas.Top="10" VerticalAlignment="Top" Height="54"  >
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Height" Value="70"  />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="Transparent" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border BorderThickness="0.0" BorderBrush="Black" Background="{TemplateBinding Background}" CornerRadius="15,15,15,15">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="0">
                            <Setter Property="Background" Value="FloralWhite" />
                            <Setter Property="Foreground" Value="Black" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="1">
                            <Setter Property="Background" Value="Yellow" />
                            <Setter Property="Foreground" Value="Black" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="2">
                            <Setter Property="Background" Value="Coral" />
                            <Setter Property="Foreground" Value="#ffffff" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="3">
                            <Setter Property="Background" Value="DarkGray" />
                            <Setter Property="Foreground" Value="#ffffff" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=furnaceElement,Path=Status}" Value="4">
                            <Setter Property="Background" Value="DarkGreen" />
                            <Setter Property="Foreground" Value="#ffffff" />
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </Button.Style>
