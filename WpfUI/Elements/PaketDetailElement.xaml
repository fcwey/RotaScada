<UserControl x:Class="WpfUI.Elements.PaketDetailElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfUI.Elements"
             mc:Ignorable="d" 
             Name="paketDetailElement"
             d:DesignHeight="90" d:DesignWidth="330">


    <Button x:Name="btn1" Background="DodgerBlue" Width="auto" Margin="5 10" FocusVisualStyle="{x:Null}"  BorderBrush="#FF707070"  >

        <Button.Style>
            <Style TargetType="Button">
                <Setter Property="Height" Value="65"  />
                <Setter Property="Foreground" Value="White" />


                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border BorderThickness="1" BorderBrush="LightGray" Background="{TemplateBinding Background}" CornerRadius="4,5,5,4">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>


                    <DataTrigger Binding="{Binding ElementName=element,Path=IsActive}" Value="True">
                        <Setter Property="Background" Value="#5F76F6" />
                        <Setter Property="Foreground" Value="#ffffff" />
                    </DataTrigger>



                    <Trigger Property="IsMouseOver" Value="True">

                    </Trigger>
                </Style.Triggers>
            </Style>
        </Button.Style>

        <Canvas Height="50" Width="304">
            <Image  Stretch="Uniform" Source="/Assets/img_folder.png" RenderTransformOrigin="0.583,1.383" HorizontalAlignment="Left" Canvas.Top="-10" VerticalAlignment="Top" Height="67" Width="63" Canvas.Left="-3" />
            <TextBlock Text="Yeni Paket-1" FontSize="15" Canvas.Left="67" Canvas.Top="3" RenderTransformOrigin="-0.265,2.381" />
            <TextBlock Text="500 C" FontSize="15" Canvas.Left="70" Canvas.Top="25" RenderTransformOrigin="-0.265,2.381" />
            <TextBlock Text="500 Kg" FontSize="15" Canvas.Left="246" Canvas.Top="25" RenderTransformOrigin="-0.265,2.381" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <TextBlock Text="ID: 123424" FontSize="15" Canvas.Left="132" Canvas.Top="24" RenderTransformOrigin="-0.265,2.381" HorizontalAlignment="Left" VerticalAlignment="Top" />



        </Canvas>




    </Button>
</UserControl>